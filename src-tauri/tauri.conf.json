{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAD Pulse",
  "version": "0.4.0",
  "identifier": "com.cadpulse.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "url": "index.html",
        "width": 320,
        "height": 252,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      },
      {
        "label": "dashboard",
        "url": "index.html",
        "title": "CAD Pulse · 详情面板",
        "width": 1040,
        "height": 940,
        "minWidth": 920,
        "minHeight": 680,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 WikG1018 · MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
